# GSE145889 H929 RNA-seq analysis configuration

# Number of CPU threads
THREADS=4

# Human reference genome: GRCh38
# Download matching FASTA and GTF files before execution
STAR_INDEX=reference/genome/star_index
GTF=reference/annotation/genes.gtf

# Set to 0, 1, or 2 after confirming library strandedness
# 0 = unstranded
# 1 = forward stranded
# 2 = reverse stranded
STRAND=UNSET

# DESeq2 thresholds
PADJ_CUTOFF=0.05
LOG2FC_CUTOFF=1
